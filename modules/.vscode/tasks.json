{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make robot dog",
            "type": "shell",
            "dependsOn": [
                "clean",
                "mkdir",
                "cmake"
            ],
            "command": "cd",
            "args": [
                "build",
                "&&",
                "make",
                "-j$(nproc)"
            ],
            "options": {
                "cwd": "${workspaceFolder}/robot-dog"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "cmake",
            "type": "shell",
            "command": "cd",
            "args": [
                "build",
                "&&",
                "cmake",
                "-DROS_ENABLE=ON",
                "-DROS2_ENABLE=OFF",
                "-DLCM_ENABLE=OFF",
                "-DDDS_ENABLE=OFF",
                "-DGLOG_ENABLE=ON",
                "-DCMAKE_BUILD_TYPE=Release",
                "../"
            ],
            "options": {
                "cwd": "${workspaceFolder}/robot-dog"
            },
            "group": "none"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "robot-dog/build"
            ],
            "group": "none"
        },
        {
            "label": "mkdir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "robot-dog/build"
            ],
            "group": "none"
        },
        {
            "label": "run robot dog",
            "type": "shell",
            "command":"bash",
            "args": [
                "start.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}/robot-dog/scripts"
            },
            "group": "build"
        }
    ]
}